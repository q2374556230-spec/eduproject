# edu-platform local Docker environment
# Copy this file to .env and adjust values if needed.

# MySQL root password used by the mysql container and Java services.
MYSQL_PASSWORD=edu123456

# JWT signing secret. Keep the same value for gateway-service and user-service.
JWT_SECRET=edu-platform-jwt-secret-key-2024-very-long-secret

# Optional Nacos namespace. Leave empty for the default public namespace.
NACOS_NAMESPACE=

# Optional Claude/Anthropic API key for course recommendations.
# If omitted or invalid, course-service falls back to hot courses.
ANTHROPIC_API_KEY=
